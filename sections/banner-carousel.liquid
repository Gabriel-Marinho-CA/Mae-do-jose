{%- comment -%}
  Banner rotativo (Swiper).

  - Cada slide é um bloco editável no painel: imagem (desktop e mobile),
    título, texto e dois botões.
  - A imagem usa o tamanho original (altura automática, sem recorte): é ela
    quem define a altura do slide, e o conteúdo fica sobreposto.
  - Layout desktop: conteúdo à esquerda, sobre a área livre da imagem.
    Layout mobile: conteúdo centralizado na parte de baixo.

  Estilos fixos ficam em assets/section-banner-carousel.css. Apenas o que
  depende do schema (cores, offset, largura) fica no {% style %} abaixo.

  Swiper é carregado globalmente no layout/theme.liquid.
{%- endcomment -%}

{%- liquid
  assign uid = 'banner-carousel-' | append: section.id
-%}

{{ 'section-banner-carousel.css' | asset_url | stylesheet_tag }}

{% style %}
  .{{ uid }} .banner-carousel__heading {
    color: {{ section.settings.text_color }};
  }

  .{{ uid }} .banner-carousel__text {
    color: {{ section.settings.text_color }};
  }

  .{{ uid }} .banner-carousel__button--primary {
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text }};
    border: 1px solid {{ section.settings.primary_button_bg }};
  }

  .{{ uid }} .banner-carousel__button--secondary {
    background: {{ section.settings.secondary_button_bg }};
    color: {{ section.settings.secondary_button_text }};
    border: 1px solid {{ section.settings.secondary_button_border }};
  }

  .{{ uid }} .banner-carousel__pagination .swiper-pagination-bullet {
    background: {{ section.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .{{ uid }} .banner-carousel__content {
      padding: 4% 4% 4% {{ section.settings.content_offset }}%;
    }

    .{{ uid }} .banner-carousel__content-inner {
      max-width: {{ section.settings.content_max_width }}px;
    }

    .{{ uid }} .banner-carousel__nav--prev {
      left: 8%;
    }

    .{{ uid }} .banner-carousel__nav--next {
      right: 8%;
    }
  }
{% endstyle %}

<div class="banner-carousel {{ uid }}" data-banner-carousel>
  <div class="swiper" data-swiper>
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide banner-carousel__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              class="banner-carousel__image banner-carousel__image--desktop"
              src="{{ block.settings.image | image_url: width: 1920 }}"
              srcset="
                {{ block.settings.image | image_url: width: 960 }} 960w,
                {{ block.settings.image | image_url: width: 1440 }} 1440w,
                {{ block.settings.image | image_url: width: 1920 }} 1920w,
                {{ block.settings.image | image_url: width: 2400 }} 2400w
              "
              sizes="100vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'banner-carousel__image banner-carousel__image--desktop placeholder-svg' }}
          {%- endif -%}

          {%- if block.settings.image_mobile != blank -%}
            <img
              class="banner-carousel__image banner-carousel__image--mobile"
              src="{{ block.settings.image_mobile | image_url: width: 750 }}"
              srcset="
                {{ block.settings.image_mobile | image_url: width: 450 }} 450w,
                {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
              width="{{ block.settings.image_mobile.width }}"
              height="{{ block.settings.image_mobile.height }}"
              alt="{{ block.settings.image_mobile.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {%- elsif block.settings.image != blank -%}
            <img
              class="banner-carousel__image banner-carousel__image--mobile"
              src="{{ block.settings.image | image_url: width: 750 }}"
              sizes="100vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'banner-carousel__image banner-carousel__image--mobile placeholder-svg' }}
          {%- endif -%}

          <div class="banner-carousel__content">
            <div class="banner-carousel__content-inner">
              {%- if block.settings.heading != blank -%}
                <h2 class="banner-carousel__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="banner-carousel__text">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                <div class="banner-carousel__buttons">
                  {%- if block.settings.button_1_label != blank -%}
                    <a
                      class="banner-carousel__button banner-carousel__button--primary"
                      {% if block.settings.button_1_link != blank %}href="{{ block.settings.button_1_link }}"{% else %}href="#" role="link" aria-disabled="true"{% endif %}
                    >
                      {{ block.settings.button_1_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_2_label != blank -%}
                    <a
                      class="banner-carousel__button banner-carousel__button--secondary"
                      {% if block.settings.button_2_link != blank %}href="{{ block.settings.button_2_link }}"{% else %}href="#" role="link" aria-disabled="true"{% endif %}
                    >
                      {{ block.settings.button_2_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_pagination -%}
      <div class="banner-carousel__pagination" data-pagination></div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
    <button type="button" class="banner-carousel__nav banner-carousel__nav--prev" data-prev aria-label="Anterior">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 1L3 7l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button type="button" class="banner-carousel__nav banner-carousel__nav--next" data-next aria-label="Próximo">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 1L3 7l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.querySelector('.{{ uid }}');
    if (!root) return;

    function initBanner() {
      if (root.dataset.swiperInit === 'true' && root.swiperInstance) {
        return;
      }

      var swiperEl = root.querySelector('[data-swiper]');
      if (!swiperEl) return;

      var options = {
        slidesPerView: 1,
        loop: {{ section.settings.loop | default: false }} && root.querySelectorAll('.swiper-slide').length > 1,
        speed: 600,
        {% if section.settings.autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_interval | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        {% endif %}
        {% if section.settings.show_pagination %}
        pagination: {
          el: root.querySelector('[data-pagination]'),
          clickable: true
        },
        {% endif %}
        {% if section.settings.show_arrows %}
        navigation: {
          prevEl: root.querySelector('[data-prev]'),
          nextEl: root.querySelector('[data-next]')
        },
        {% endif %}
        a11y: { enabled: true }
      };

      root.swiperInstance = new Swiper(swiperEl, options);
      root.dataset.swiperInit = 'true';
    }

    function whenReady(cb) {
      if (window.Swiper) return cb();
      var tries = 0;
      var timer = setInterval(function () {
        if (window.Swiper || tries++ > 100) {
          clearInterval(timer);
          if (window.Swiper) cb();
        }
      }, 50);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { whenReady(initBanner); });
    } else {
      whenReady(initBanner);
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        if (root.swiperInstance) {
          root.swiperInstance.destroy(true, true);
          root.dataset.swiperInit = 'false';
        }
        whenReady(initBanner);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Banner rotativo",
  "tag": "section",
  "class": "section-banner-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Carrossel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproduzir automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Intervalo entre slides",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Repetir em loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar setas (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Mostrar indicadores",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout do conteúdo (desktop)"
    },
    {
      "type": "range",
      "id": "content_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "label": "Distância do conteúdo à esquerda",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 320,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Largura máxima do conteúdo",
      "default": 620
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#1a2e2d"
    },
    {
      "type": "color",
      "id": "primary_button_bg",
      "label": "Botão principal — fundo",
      "default": "#043c39"
    },
    {
      "type": "color",
      "id": "primary_button_text",
      "label": "Botão principal — texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_bg",
      "label": "Botão secundário — fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_text",
      "label": "Botão secundário — texto",
      "default": "#043c39"
    },
    {
      "type": "color",
      "id": "secondary_button_border",
      "label": "Botão secundário — borda",
      "default": "#e8e4dc"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem (mobile)",
          "info": "Se vazio, usa a imagem de desktop."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Sabor artesanal, ingredientes de chef"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Quiches, tortas, pratos prontos e muito mais — feitos com ingredientes selecionados e entregues direto na sua mesa.</p>"
        },
        {
          "type": "header",
          "content": "Botão principal"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Texto do botão",
          "default": "Ver Cardápio"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Link do botão"
        },
        {
          "type": "header",
          "content": "Botão secundário"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Texto do botão",
          "default": "Personalizado"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Link do botão"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner rotativo",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
