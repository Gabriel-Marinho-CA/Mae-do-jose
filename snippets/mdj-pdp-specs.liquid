{%- comment -%}
  Painel "Especificações".

  Fonte: product.metafields.custom.epecificacao (list.single_line_text_field).
  Cada item da lista é uma linha "Rótulo | Valor". Também são aceitos os
  separadores "::" e ":" — o primeiro encontrado, nessa ordem, é o que vale.

  Aceita:
  - product: {Object} produto atual.
  - block: {Object} bloco da section.

  Uso:
  {% render 'mdj-pdp-specs', product: product, block: block %}
{%- endcomment -%}

{%- assign specs = product.metafields.custom.epecificacao.value -%}

{%- if specs.size > 0 -%}
  <mdj-panel class="mdj-pdp" {{ block.shopify_attributes }}>
    <details class="mdj-panel" open>
      <summary class="mdj-panel__summary">
        <h2 class="mdj-panel__title">{{ block.settings.heading | default: 'Especificações' | escape }}</h2>
        <span class="mdj-panel__icon" aria-hidden="true"></span>
      </summary>

      <div class="mdj-panel__body">
        <dl class="mdj-specs">
          {%- for spec in specs -%}
            {%- liquid
              if spec == blank
                continue
              endif

              assign separator = '|'
              assign parts = spec | split: separator
              if parts.size < 2
                assign separator = '::'
                assign parts = spec | split: separator
              endif
              if parts.size < 2
                assign separator = ':'
                assign parts = spec | split: separator
              endif

              if parts.size < 2
                assign spec_label = spec | strip
                assign spec_value = ''
              else
                assign rest_count = parts.size | minus: 1
                assign spec_label = parts[0] | strip
                assign spec_value = parts | slice: 1, rest_count | join: separator | strip
              endif
            -%}

            <div class="mdj-specs__row">
              <dt class="mdj-specs__label">{{ spec_label | escape }}</dt>
              <dd class="mdj-specs__value">{{ spec_value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      </div>
    </details>
  </mdj-panel>
{%- endif -%}
